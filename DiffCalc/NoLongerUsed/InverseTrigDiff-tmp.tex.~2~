    \begin{multicols}{2}
    \item
      $\dx{\left(\dfrac1a\inverse\tan\left(\dfrac{x}{a}\right)\right)}=\dfrac{1}{a^2+x^2}\dx{x}$
      \item
        $\dx{\left(\dfrac1a\inverse\sin\left(\dfrac{x}{a}\right)\right)}=\dfrac{1}{a\sqrt{a^2-x^2}}\dx{x}$
