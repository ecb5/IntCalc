             $\dx{\left(\dfrac1a\inverse\sec\left(\dfrac{x}{a}\right)\right)}=\dfrac{1}{\abs{x}\sqrt{x^2-a^2}}\dx{x}$
           \end{multicols}
         \end{enumerate}
\end{ProficiencyDrill}

